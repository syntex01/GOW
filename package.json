{
  "name": "grimdark-tabletop",
  "version": "0.1.0",
  "private": true,
  "description": "A turn-based, tabletop-faithful grimdark wargame simulator for testing armies and developing strategies.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
